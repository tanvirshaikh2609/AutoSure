# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=car_service_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Application
APP_NAME=AutoSure
APP_VERSION=1.0.0
DEBUG=True

# Business info
COMPANY_NAME=Easy Ride Auto Service
COMPANY_ADDRESS=Gujarat, India
COMPANY_PHONE=+91 98765 43210
