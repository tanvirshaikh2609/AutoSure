# Invoicing
INVOICE_PREFIX=INV
ORDER_PREFIX=WO
PAYMENT_TERMS_DAYS=30

# Currency
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR

# Rates
DEFAULT_LABOR_RATE=500.00
SESSION_TIMEOUT_MINUTES=60
LOW_STOCK_THRESHOLD=10
